<Page x:Class="ArturGabdrakhmanov422_DogAndCat.Pages.DogAndCatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ArturGabdrakhmanov422_DogAndCat.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DogAndCatPage">

    <Grid Margin="10" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" Width="250" Height="30" FontSize="14" Padding="5"
                  TextChanged="SearchBox_TextChanged" VerticalAlignment="Center"/>
            <ComboBox x:Name="SortComboBox" SelectionChanged="SortComboBox_SelectionChanged" Margin="5 0 0 0">
                <ComboBoxItem Content="По имени (А-Я)" />
                <ComboBoxItem Content="По имени (Я-А)" />
            </ComboBox>

            <Button Content="Добавить фото" Width="150" Height="30" Name="AddPhotoBtn" FontSize="14"
                 Margin="10,0,0,0"
                 Click="AddPhotoBtn_Click"/>
            <Button x:Name="LogoutBtn" Content="Выйти" Click="LogoutBtn_Click" HorizontalAlignment="Right" Margin="10"/>
        </StackPanel>


        <ListView x:Name="PhotosListView" Grid.Row="1"
       Background="White" BorderThickness="1" BorderBrush="Gray"
       ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Фото" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding PhotoSource}" Width="100" Height="100"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding PhotoName}" Width="200"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>

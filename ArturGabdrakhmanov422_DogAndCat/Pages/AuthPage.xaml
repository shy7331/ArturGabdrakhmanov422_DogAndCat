<Page x:Class="ArturGabdrakhmanov422_DogAndCat.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ArturGabdrakhmanov422_DogAndCat.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid Background="White">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="250">
            <TextBlock Text="Введите имя" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBox x:Name="UsernameBox"  Margin="0,0,0,10" FontSize="14"/>
            <Button Content="Войти"  Name="LoginBtn"  
             FontSize="16" Height="40" BorderThickness="0" Cursor="Hand" Click="LoginBtn_Click"/>
        </StackPanel>
    </Grid>

</Page>

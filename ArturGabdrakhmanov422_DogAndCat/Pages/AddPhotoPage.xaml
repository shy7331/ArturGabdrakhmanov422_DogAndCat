<Page x:Class="ArturGabdrakhmanov422_DogAndCat.Pages.AddPhotoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ArturGabdrakhmanov422_DogAndCat.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddPhotoPage">

    <Grid Background="White">
        <StackPanel Margin="20">
            <TextBlock Text="Название фото:" FontWeight="Bold"/>
            <TextBox x:Name="PhotoNameTb" Height="30"/>

            <TextBlock Text="Выберите питомца:" FontWeight="Bold" Margin="0,10,0,0"/>
            <ComboBox x:Name="DogComboCb" Height="30"/>

            <TextBlock Text="Фото:" FontWeight="Bold" Margin="0,10,0,0"/>
            <Image x:Name="PhotoPreview" Width="200" Height="150" Stretch="Uniform"/>

            <Button Content="Выбрать фото"  x:Name="SelectPhotoBtn" 
                FontSize="14" Width="100" BorderThickness="0" Margin="0,10,0,0" Click="SelectPhotoBtn_Click"/>
            <Button Content="Добавить фото"   Width="100" x:Name="AddPhotoBtn" 
                FontSize="14" BorderThickness="0" Margin="0,10,0,0" Click="AddPhotoBtn_Click"/>
            <Button Content="Назад"  Width="100" x:Name="BackBtn" 
    FontSize="14"  BorderThickness="0" Margin="0,10,0,0" Click="BackBtn_Click" />
        </StackPanel>
    </Grid>
</Page>
